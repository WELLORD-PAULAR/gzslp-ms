erDiagram
    USERS ||--o| CARTS : owns
    USERS ||--o{ ORDERS : places
    USERS ||--o{ INVENTORY_MOVEMENTS : records

    CARTS ||--o{ CART_ITEMS : contains
    PRODUCTS o|--o{ CART_ITEMS : selected_product
    PRODUCT_VARIANTS o|--o{ CART_ITEMS : selected_variant
    SERVICES o|--o{ CART_ITEMS : selected_service

    PRODUCTS ||--o{ PRODUCT_VARIANTS : has
    ORDERS ||--o{ ORDER_ITEMS : contains
    PRODUCTS o|--o{ ORDER_ITEMS : source_product
    PRODUCT_VARIANTS o|--o{ ORDER_ITEMS : source_variant
    SERVICES o|--o{ ORDER_ITEMS : source_service

    INVENTORY_ITEMS ||--o{ INVENTORY_ITEM_SUPPLIER : supply_links
    SUPPLIERS ||--o{ INVENTORY_ITEM_SUPPLIER : supplier_links
    INVENTORY_ITEMS ||--o{ INVENTORY_MOVEMENTS : has_history
    SUPPLIERS o|--o{ INVENTORY_MOVEMENTS : receipt_source
    ORDERS o|--o{ INVENTORY_MOVEMENTS : production_usage
    PRODUCT_VARIANTS ||--o{ PRODUCT_VARIANT_SUPPLIES : recipe_lines
    INVENTORY_ITEMS ||--o{ PRODUCT_VARIANT_SUPPLIES : recipe_material

    USERS {
        INTEGER id PK
        VARCHAR(255) name
        VARCHAR(255) email UK
        TIMESTAMP email_verified_at
        VARCHAR(255) password
        VARCHAR(100) remember_token
        VARCHAR(255) role
        VARCHAR(25) phone
        BOOLEAN is_active
        DATETIME created_at
        DATETIME updated_at
    }

    PRODUCTS {
        INTEGER id PK
        VARCHAR(255) name
        TEXT description
        VARCHAR(255) category
        DECIMAL(10,2) price
        VARCHAR(80) paper_size
        VARCHAR(80) paper_weight
        VARCHAR(80) paper_finish
        VARCHAR(255) image_path
        BOOLEAN is_active
        INTEGER lock_version
        DATETIME created_at
        DATETIME updated_at
    }

    PRODUCT_VARIANTS {
        INTEGER id PK
        INTEGER product_id FK
        VARCHAR(255) name
        VARCHAR(255) sku UK
        JSON options
        DECIMAL(10,2) price
        BOOLEAN is_default
        BOOLEAN is_active
        INTEGER lock_version
        DATETIME created_at
        DATETIME updated_at
    }

    SERVICES {
        INTEGER id PK
        VARCHAR(255) name
        TEXT description
        DECIMAL(10,2) starting_price
        VARCHAR(255) image_path
        BOOLEAN is_active
        INTEGER lock_version
        DATETIME created_at
        DATETIME updated_at
    }

    CARTS {
        INTEGER id PK
        INTEGER user_id FK, UK
        DATETIME created_at
        DATETIME updated_at
    }

    CART_ITEMS {
        INTEGER id PK
        INTEGER cart_id FK
        INTEGER product_id FK
        INTEGER product_variant_id FK
        INTEGER service_id FK
        INTEGER quantity
        DATETIME created_at
        DATETIME updated_at
    }

    ORDERS {
        INTEGER id PK
        INTEGER user_id FK
        VARCHAR(255) status
        DECIMAL(10,2) subtotal
        DECIMAL(10,2) quoted_total
        TIMESTAMP customer_accepted_at
        VARCHAR(255) artwork_path
        TEXT customer_note
        TEXT admin_note
        TIMESTAMP inventory_consumed_at
        DATETIME created_at
        DATETIME updated_at
    }

    ORDER_ITEMS {
        INTEGER id PK
        INTEGER order_id FK
        INTEGER product_id FK
        INTEGER product_variant_id FK
        INTEGER service_id FK
        VARCHAR(255) item_name
        TEXT item_description
        DECIMAL(10,2) unit_price
        INTEGER quantity
        VARCHAR(255) variant_name
        JSON variant_options
        VARCHAR(80) paper_size
        VARCHAR(80) paper_weight
        VARCHAR(80) paper_finish
        DATETIME created_at
        DATETIME updated_at
    }

    SUPPLIERS {
        INTEGER id PK
        VARCHAR(255) name
        VARCHAR(255) email
        VARCHAR(25) phone
        VARCHAR(255) address
        BOOLEAN is_active
        DATETIME created_at
        DATETIME updated_at
    }

    INVENTORY_ITEMS {
        INTEGER id PK
        VARCHAR(255) name
        VARCHAR(255) sku UK
        VARCHAR(255) category
        VARCHAR(32) unit
        DECIMAL(12,3) quantity_on_hand
        DECIMAL(12,3) reorder_level
        BOOLEAN is_active
        INTEGER lock_version
        DATETIME created_at
        DATETIME updated_at
    }

    INVENTORY_ITEM_SUPPLIER {
        INTEGER inventory_item_id PK, FK
        INTEGER supplier_id PK, FK
    }

    INVENTORY_MOVEMENTS {
        INTEGER id PK
        INTEGER inventory_item_id FK
        INTEGER supplier_id FK
        INTEGER user_id FK
        INTEGER order_id FK
        VARCHAR(255) type
        DECIMAL(12,3) quantity_change
        DECIMAL(12,3) quantity_before
        DECIMAL(12,3) quantity_after
        TEXT notes
        TIMESTAMP created_at
    }

    PRODUCT_VARIANT_SUPPLIES {
        INTEGER product_variant_id PK, FK
        INTEGER inventory_item_id PK, FK
        DECIMAL(12,3) quantity_per_unit
    }
