erDiagram
    USERS ||--o| CARTS : owns
    USERS ||--o{ ORDERS : places
    USERS ||--o{ INVENTORY_MOVEMENTS : records

    CARTS ||--o{ CART_ITEMS : contains

    PRODUCTS ||--o{ PRODUCT_VARIANTS : has
    PRODUCTS o|--o{ CART_ITEMS : referenced_by
    PRODUCTS o|--o{ ORDER_ITEMS : source

    PRODUCT_VARIANTS ||--o{ CART_ITEMS : selected_variant
    PRODUCT_VARIANTS ||--o{ ORDER_ITEMS : variant_snapshot
    PRODUCT_VARIANTS }o--o{ INVENTORY_ITEMS : consumes_via_recipe

    SERVICES ||--o{ CART_ITEMS : referenced_by
    SERVICES ||--o{ ORDER_ITEMS : referenced_by

    ORDERS ||--|{ ORDER_ITEMS : snapshots
    ORDERS ||--o{ INVENTORY_MOVEMENTS : uses_material_for
    INVENTORY_ITEMS }o--o{ SUPPLIERS : sourced_from
    INVENTORY_ITEMS ||--o{ INVENTORY_MOVEMENTS : records
    PRODUCT_VARIANTS ||--o{ PRODUCT_VARIANT_SUPPLIES : recipe
    INVENTORY_ITEMS ||--o{ PRODUCT_VARIANT_SUPPLIES : used_in_recipe

    USERS {
        bigint id PK
        string name
        string email
        string role
        boolean is_active
    }

    CARTS {
        bigint id PK
        bigint user_id FK
    }

    CART_ITEMS {
        bigint id PK
        bigint cart_id FK
        bigint product_id FK
        bigint product_variant_id FK
        bigint service_id FK
        int quantity
    }

    PRODUCTS {
        bigint id PK
        string name
        string description
        string category
        decimal price
        string paper_size
        string paper_weight
        string paper_finish
        string image_path
        boolean is_active
        int lock_version
    }

    PRODUCT_VARIANTS {
        bigint id PK
        bigint product_id FK
        string name
        string sku
        json options
        decimal price
        boolean is_default
        boolean is_active
        int lock_version
    }

    SERVICES {
        bigint id PK
        string name
        string description
        decimal starting_price
        string image_path
        boolean is_active
        int lock_version
    }

    ORDERS {
        bigint id PK
        bigint user_id FK
        string status
        decimal subtotal
        decimal quoted_total
        timestamp customer_accepted_at
        string artwork_path
        text customer_note
        text admin_note
        timestamp inventory_consumed_at
    }

    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint product_id FK
        bigint product_variant_id FK
        bigint service_id FK
        string item_name
        text item_description
        decimal unit_price
        int quantity
        string variant_name
        json variant_options
        string paper_size
        string paper_weight
        string paper_finish
    }

    SUPPLIERS {
        bigint id PK
        string name
        string email
        string phone
        string address
        boolean is_active
    }

    INVENTORY_ITEMS {
        bigint id PK
        string name
        string sku
        string category
        string unit
        decimal quantity_on_hand
        decimal reorder_level
        boolean is_active
        int lock_version
    }

    INVENTORY_MOVEMENTS {
        bigint id PK
        bigint inventory_item_id FK
        bigint supplier_id FK
        bigint user_id FK
        bigint order_id FK
        string type
        decimal quantity_change
        decimal quantity_before
        decimal quantity_after
        text notes
    }

    PRODUCT_VARIANT_SUPPLIES {
        bigint product_variant_id FK
        bigint inventory_item_id FK
        decimal quantity_per_unit
    }
